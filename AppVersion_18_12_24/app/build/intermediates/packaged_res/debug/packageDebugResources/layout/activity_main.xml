<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/button_open_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Map" />

        <Button
            android:id="@+id/button_request_notification_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request Notification Access" />

        <Button
            android:id="@+id/button_view_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Notifications" />

        <Button
            android:id="@+id/button_view_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Messages" />

        <Button
            android:id="@+id/button_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health" />

        <Button
            android:id="@+id/btn_call_logs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Показать звонки" />

        <Button
            android:id="@+id/btn_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Показать контакты" />

        <Button
            android:id="@+id/btn_app_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Использование приложений" />

        <Button
            android:id="@+id/sign_out_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выйти из аккаунта" />

        <TextView
            android:id="@+id/btn_screen_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Время экрана: 0"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center" />

    </LinearLayout>
</ScrollView>
